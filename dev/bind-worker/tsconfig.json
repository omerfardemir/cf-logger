{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@types/node", "@cloudflare/workers-types"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
