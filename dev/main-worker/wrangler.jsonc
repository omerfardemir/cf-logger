{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pino-log-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "destinations": ["grafana-logs"],
      "head_sampling_rate": 1,
    },
  },
  "services": [
    {
      "binding": "BIND",
      "service": "bind-test",
    },
    {
      // A plain WorkerEntrypoint wrapped with withLogging() (dev/math-worker/src/index.ts).
      "binding": "LOGGED",
      "service": "math-test",
      "entrypoint": "LoggedMath",
    },
  ],
  // Units of work outside HTTP (src/units.ts), driven by scripts/e2e-local.mjs.
  // Cron runs locally through /cdn-cgi/handler/scheduled. Before `pnpm dev:deploy`,
  // create the queue: `wrangler queues create loggercf-dev-jobs`.
  "triggers": { "crons": ["0 3 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "loggercf-dev-jobs" }],
    "consumers": [{ "queue": "loggercf-dev-jobs", "max_batch_timeout": 1 }],
  },
  "workflows": [{ "name": "loggercf-dev-report", "binding": "REPORT", "class_name": "Report" }],
  "vars": {
    "ENVIRONMENT": "development",
    "RELEASE": "e69d9c8",
    "VERSION": "1.0.0",
    "NAME": "pino-log-test",
    "LOG_LEVEL": "debug",
  },
}
